@@ -0,0 +1,153 @@
+import os
+import numpy as np
+import pandas as pd
+import matplotlib.pyplot as plt
+
+
+# =========================
+# Config
+# =========================
+CSV_PATH = "./results/test_subset_inference.csv"
+OUTPUT_DIR = "./results/plots"
+THRESHOLDS = np.round(np.linspace(0.0, 1.0, 101), 2)
+
+
+def safe_div(a, b):
+    return a / b if b != 0 else 0.0
+
+
+def compute_point_metrics(y_true, y_pred):
+    tp = int(np.sum((y_true == 1) & (y_pred == 1)))
+    fp = int(np.sum((y_true == 0) & (y_pred == 1)))
+    tn = int(np.sum((y_true == 0) & (y_pred == 0)))
+    fn = int(np.sum((y_true == 1) & (y_pred == 0)))
+
+    precision = safe_div(tp, tp + fp)
+    recall = safe_div(tp, tp + fn)
+    accuracy = safe_div(tp + tn, tp + tn + fp + fn)
+    f1 = safe_div(2 * precision * recall, precision + recall)
+
+    return {
+        "TP": tp,
+        "FP": fp,
+        "TN": tn,
+        "FN": fn,
+        "precision": precision,
+        "recall": recall,
+        "accuracy": accuracy,
+        "f1": f1,
+    }
+
+
+def compute_event_recall(df, y_pred_col="y_pred_tmp"):
+    event_tp = 0
+    event_total = 0
+
+    for serial, g in df.groupby("serial_number"):
+        has_failure = (g["y_true"] == 1).any()
+        if has_failure:
+            event_total += 1
+            detected = ((g["y_true"] == 1) & (g[y_pred_col] == 1)).any()
+            if detected:
+                event_tp += 1
+
+    event_recall = safe_div(event_tp, event_total)
+    return event_tp, event_total, event_recall
+
+
+def threshold_sweep(df, thresholds):
+    y_true = df["y_true"].values.astype(int)
+    probs = df["prob"].values.astype(float)
+
+    rows = []
+
+    for thr in thresholds:
+        y_pred = (probs >= thr).astype(int)
+
+        metrics = compute_point_metrics(y_true, y_pred)
+
+        tmp = df.copy()
+        tmp["y_pred_tmp"] = y_pred
+        event_tp, event_total, event_recall = compute_event_recall(tmp, "y_pred_tmp")
+
+        rows.append({
+            "threshold": float(thr),
+            **metrics,
+            "event_tp": event_tp,
+            "event_total": event_total,
+            "event_recall": event_recall,
+        })
+
+    return pd.DataFrame(rows)
+
+
+def plot_pr_curve(result_df, output_path):
+    plt.figure(figsize=(7, 5))
+    plt.plot(result_df["recall"], result_df["precision"], marker="o", markersize=3)
+    plt.xlabel("Recall")
+    plt.ylabel("Precision")
+    plt.title("Precision-Recall Curve")
+    plt.grid(True, alpha=0.3)
+    plt.tight_layout()
+    plt.savefig(output_path, dpi=200)
+    plt.close()
+
+
+def plot_threshold_curves(result_df, output_path):
+    plt.figure(figsize=(8, 5))
+    plt.plot(result_df["threshold"], result_df["precision"], label="Precision")
+    plt.plot(result_df["threshold"], result_df["recall"], label="Recall")
+    plt.plot(result_df["threshold"], result_df["f1"], label="F1")
+    plt.plot(result_df["threshold"], result_df["accuracy"], label="Accuracy")
+    plt.plot(result_df["threshold"], result_df["event_recall"], label="Event Recall")
+    plt.xlabel("Threshold")
+    plt.ylabel("Metric Value")
+    plt.title("Threshold vs Metrics")
+    plt.legend()
+    plt.grid(True, alpha=0.3)
+    plt.tight_layout()
+    plt.savefig(output_path, dpi=200)
+    plt.close()
+
+
+def main():
+    os.makedirs(OUTPUT_DIR, exist_ok=True)
+
+    df = pd.read_csv(CSV_PATH)
+
+    required_cols = ["serial_number", "y_true", "prob"]
+    missing = [c for c in required_cols if c not in df.columns]
+    if missing:
+        raise ValueError(f"Missing required columns in CSV: {missing}")
+
+    result_df = threshold_sweep(df, THRESHOLDS)
+
+    threshold_csv = os.path.join(OUTPUT_DIR, "threshold_metrics.csv")
+    pr_png = os.path.join(OUTPUT_DIR, "pr_curve.png")
+    thr_png = os.path.join(OUTPUT_DIR, "threshold_performance_curve.png")
+
+    result_df.to_csv(threshold_csv, index=False)
+    plot_pr_curve(result_df, pr_png)
+    plot_threshold_curves(result_df, thr_png)
+
+    best_f1_row = result_df.loc[result_df["f1"].idxmax()]
+    best_precision_row = result_df.loc[result_df["precision"].idxmax()]
+    best_recall_row = result_df.loc[result_df["recall"].idxmax()]
+
+    print("\nSaved files:")
+    print(f"  {threshold_csv}")
+    print(f"  {pr_png}")
+    print(f"  {thr_png}")
+
+    print("\nBest threshold by F1:")
+    print(best_f1_row.to_string())
+
+    print("\nBest threshold by Precision:")
+    print(best_precision_row.to_string())
+
+    print("\nBest threshold by Recall:")
+    print(best_recall_row.to_string())
+
+
+if __name__ == "__main__":
+    main()
