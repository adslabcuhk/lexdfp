@@ -0,0 +1,431 @@
+import os
+import random
+import numpy as np
+import pandas as pd
+import torch
+import json
+
+from models import TimeLLM
+
+
+FEATURE_JSON_PATH = "" # TODO: path to the feature json file
+
+# =========================================================
+# Source model vs target data
+# =========================================================
+MODEL_DISK_MODEL = "HGST HUH721212ALN604"   # checkpoint / feature schema comes from this model
+DATA_DISK_MODEL  = "HGST HUH721212ALE604"   # inference data comes from this model
+
+# =========================================================
+# Config
+# =========================================================
+CKPT_PATH = f"./ckpt/time_llm_{MODEL_DISK_MODEL}.pth"
+
+TEST_CSV = "" # TODO: path to the csv of the DATA_DISK_MODEL
+
+LOCAL_INFERENCE_CSV = (
+    "" # TODO: path to the csv file of the DATA_DISK_MODEL test dataset
+)
+USE_LOCAL_INFERENCE_CSV = LOCAL_INFERENCE_CSV is not None
+
+OUTPUT_CSV = f"./results/{MODEL_DISK_MODEL}__to__{DATA_DISK_MODEL}_inference.csv"
+
+RANDOM_SEED = 42
+NUM_SERIALS = 10
+SEQ_LEN = 14
+ALLOW_SHORT_HISTORY = True
+PRED_LEN = 1
+LABEL_LEN = 0
+BATCH_SIZE = 64
+
+TARGET_COL = "failure_7d"
+
+
+# =========================================================
+# Args for TimeLLM
+# =========================================================
+class Args:
+    def __init__(self):
+        self.task_name = "classification"
+
+        self.seq_len = SEQ_LEN
+        self.label_len = LABEL_LEN
+        self.pred_len = PRED_LEN
+
+        self.enc_in = None
+        self.dec_in = None
+        self.c_out = 1
+
+        self.d_model = 16
+        self.n_heads = 8
+        self.e_layers = 2
+        self.d_layers = 1
+        self.d_ff = 32
+        self.factor = 1
+        self.dropout = 0.1
+        self.embed = "timeF"
+        self.activation = "gelu"
+        self.output_attention = False
+
+        self.patch_len = 16
+        self.stride = 8
+        self.prompt_domain = 0
+
+        self.llm_model = "GPT2"
+        self.llm_dim = 768
+        self.llm_layers = 6
+
+        self.model = "TimeLLM"
+        self.model_id = "cross_model_inference"
+        self.model_comment = f"{MODEL_DISK_MODEL}_to_{DATA_DISK_MODEL}"
+        self.des = "cross_model_inference"
+
+        self.use_amp = False
+        self.content = "Backblaze disk failure prediction"
+
+
+# =========================================================
+# Helpers
+# =========================================================
+def build_time_features(dt_index: pd.DatetimeIndex) -> np.ndarray:
+    """
+    Build simple time marks:
+    month / day / weekday
+    shape: [seq_len, 3]
+    """
+    return np.stack(
+        [
+            dt_index.month.values,
+            dt_index.day.values,
+            dt_index.weekday.values,
+        ],
+        axis=1,
+    ).astype(np.float32)
+
+
+def build_samples_from_subset(df: pd.DataFrame):
+    """
+    Build sliding-window samples from selected serials.
+
+    One inference sample per row.
+    If there are fewer than SEQ_LEN historical rows available,
+    left-pad by repeating the earliest row.
+    """
+    samples = []
+
+    df = df.copy()
+    df["date"] = pd.to_datetime(df["date"])
+    df = df.sort_values(["serial_number", "date"]).reset_index(drop=True)
+
+    skipped_short_serials = 0
+
+    for serial, g in df.groupby("serial_number"):
+        g = g.sort_values("date").reset_index(drop=True)
+
+        if len(g) < SEQ_LEN and not ALLOW_SHORT_HISTORY:
+            skipped_short_serials += 1
+            continue
+
+        feat_arr = g[FEATURE_COLS].astype(np.float32).fillna(0.0).values
+        label_arr = g[TARGET_COL].fillna(0).astype(np.float32).values
+        date_arr = pd.to_datetime(g["date"])
+
+        if ALLOW_SHORT_HISTORY:
+            end_indices = range(len(g))
+        else:
+            end_indices = range(SEQ_LEN - 1, len(g))
+
+        for end_idx in end_indices:
+            start_idx = max(0, end_idx - SEQ_LEN + 1)
+
+            seq_x = feat_arr[start_idx:end_idx + 1]
+            x_dates = date_arr.iloc[start_idx:end_idx + 1]
+            y_true = float(label_arr[end_idx])
+            end_date = x_dates.iloc[-1]
+
+            current_len = seq_x.shape[0]
+            if current_len < SEQ_LEN:
+                pad_len = SEQ_LEN - current_len
+                pad_feat = np.repeat(seq_x[:1], pad_len, axis=0)
+                seq_x = np.concatenate([pad_feat, seq_x], axis=0)
+
+                first_date = x_dates.iloc[0]
+                pad_dates = pd.DatetimeIndex([first_date] * pad_len)
+                x_dates = pd.DatetimeIndex(pad_dates.tolist() + list(pd.DatetimeIndex(x_dates)))
+            else:
+                x_dates = pd.DatetimeIndex(x_dates)
+
+            seq_x_mark = build_time_features(x_dates)
+            seq_y_mark = build_time_features(pd.DatetimeIndex([end_date]))
+
+            samples.append(
+                {
+                    "serial_number": serial,
+                    "end_date": str(end_date.date()),
+                    "seq_x": seq_x,
+                    "seq_x_mark": seq_x_mark,
+                    "seq_y_mark": seq_y_mark,
+                    "y_true": int(y_true),
+                }
+            )
+
+    if skipped_short_serials > 0:
+        print(f"Skipped {skipped_short_serials} short serials because ALLOW_SHORT_HISTORY is False")
+
+    return samples
+
+
+def batchify_samples(samples, batch_size):
+    for start in range(0, len(samples), batch_size):
+        yield samples[start:start + batch_size]
+
+
+def collate_batch(batch):
+    seq_x = torch.tensor(np.stack([x["seq_x"] for x in batch]), dtype=torch.float32)
+    seq_x_mark = torch.tensor(np.stack([x["seq_x_mark"] for x in batch]), dtype=torch.float32)
+    seq_y_mark = torch.tensor(np.stack([x["seq_y_mark"] for x in batch]), dtype=torch.float32)
+
+    metadata = [
+        {
+            "serial_number": x["serial_number"],
+            "end_date": x["end_date"],
+            "y_true": x["y_true"],
+        }
+        for x in batch
+    ]
+
+    return seq_x, seq_x_mark, seq_y_mark, metadata
+
+
+def load_model():
+    args = Args()
+    args.enc_in = len(FEATURE_COLS)
+    args.dec_in = len(FEATURE_COLS)
+
+    model = TimeLLM.Model(args)
+
+    print(f"Loading checkpoint from: {CKPT_PATH}")
+    ckpt = torch.load(CKPT_PATH, map_location="cpu")
+
+    model_state = model.state_dict()
+    matched_state = {}
+    skipped = []
+
+    for k, v in ckpt.items():
+        if k in model_state and model_state[k].shape == v.shape:
+            matched_state[k] = v
+        else:
+            target_shape = tuple(model_state[k].shape) if k in model_state else None
+            skipped.append((k, tuple(v.shape), target_shape))
+
+    model_state.update(matched_state)
+    model.load_state_dict(model_state, strict=False)
+
+    print(f"Matched params loaded: {len(matched_state)}")
+    print(f"Skipped params: {len(skipped)}")
+    if skipped:
+        print("First skipped params:")
+        for item in skipped[:10]:
+            print(item)
+
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    model = model.to(device)
+
+    print(f"Model device: {next(model.parameters()).device}")
+    model.eval()
+    return model, args
+
+
+def load_inference_dataframe():
+    """
+    Load either:
+    1) a user-provided local csv for full inference, or
+    2) the default test csv for DATA_DISK_MODEL.
+    """
+    csv_path = LOCAL_INFERENCE_CSV if USE_LOCAL_INFERENCE_CSV else TEST_CSV
+    print(f"Loading inference data from: {csv_path}")
+    # df = pd.read_csv(csv_path)
+    df = pd.read_csv(
+        csv_path,
+        low_memory=False,
+        na_values=["\\N", "NULL", "null", "None", ""]
+    )
+    print(f"Loaded dataframe length: {len(df)}")
+    return df
+
+
+def align_feature_columns(df: pd.DataFrame, feature_cols):
+    """
+    Keep the MODEL_DISK_MODEL feature order, but tolerate missing features in the
+    target dataframe by creating them as all-zero columns.
+
+    This preserves the checkpoint input dimension, so cross-model inference can
+    still run even when DATA_DISK_MODEL does not contain every expected feature.
+    """
+    df = df.copy()
+
+    missing_feature_cols = [c for c in feature_cols if c not in df.columns]
+    present_feature_cols = [c for c in feature_cols if c in df.columns]
+
+    if missing_feature_cols:
+        print(f"Missing {len(missing_feature_cols)} feature columns in target data.")
+        print("They will be added as 0.0-filled columns so inference can continue.")
+        print("First missing features:", missing_feature_cols[:20])
+        for c in missing_feature_cols:
+            df[c] = 0.0
+    else:
+        print("All expected feature columns are present.")
+
+    print(f"Present feature columns: {len(present_feature_cols)} / {len(feature_cols)}")
+    return df, present_feature_cols, missing_feature_cols
+
+# =========================================================
+# Main
+# =========================================================
+def main():
+    random.seed(RANDOM_SEED)
+    np.random.seed(RANDOM_SEED)
+
+    if not os.path.exists(CKPT_PATH):
+        raise FileNotFoundError(f"Checkpoint not found: {CKPT_PATH}")
+
+    with open(FEATURE_JSON_PATH, "r") as f:
+        feature_map = json.load(f)
+
+    if MODEL_DISK_MODEL not in feature_map:
+        raise ValueError(f"{MODEL_DISK_MODEL} not found in feature json")
+
+    selected_base = feature_map[MODEL_DISK_MODEL]
+
+    global FEATURE_COLS
+    FEATURE_COLS = [f"{x}_raw" for x in selected_base]
+
+    print("=" * 80)
+    print("Cross-model / cross-dataset inference")
+    print(f"MODEL_DISK_MODEL = {MODEL_DISK_MODEL}")
+    print(f"DATA_DISK_MODEL  = {DATA_DISK_MODEL}")
+    print(f"Using feature schema from MODEL_DISK_MODEL")
+    print(f"Number of features = {len(FEATURE_COLS)}")
+    print("=" * 80)
+
+    os.makedirs("./results", exist_ok=True)
+
+    df = load_inference_dataframe()
+
+    required_non_feature_cols = ["date", "serial_number", TARGET_COL]
+    missing_non_feature = [c for c in required_non_feature_cols if c not in df.columns]
+    if missing_non_feature:
+        raise ValueError(
+            f"Missing required non-feature columns in DATA_DISK_MODEL dataframe:\n{missing_non_feature}"
+        )
+
+    df["date"] = pd.to_datetime(df["date"])
+    df, present_feature_cols, missing_feature_cols = align_feature_columns(df, FEATURE_COLS)
+
+    if USE_LOCAL_INFERENCE_CSV:
+        df_subset = df.copy()
+        print(f"Using local inference csv with {len(df_subset)} rows")
+        print(f"Distinct serials: {df_subset['serial_number'].nunique()}")
+        print(f"Date range: {df_subset['date'].min()} -> {df_subset['date'].max()}")
+        print("Running full inference on all rows in the provided csv")
+    else:
+        # Fallback sampling logic for plain test.csv mode
+        if "failure" not in df.columns:
+            raise ValueError("Column 'failure' is required for sampled test inference mode")
+
+        failure_serials = df.loc[df["failure"] == 1, "serial_number"].drop_duplicates().tolist()
+        healthy_serials = df.loc[~df["serial_number"].isin(failure_serials), "serial_number"].drop_duplicates().tolist()
+
+        num_failure = min(5, len(failure_serials))
+        num_healthy = min(5, len(healthy_serials))
+
+        chosen_failure = random.sample(failure_serials, num_failure) if num_failure > 0 else []
+        chosen_healthy = random.sample(healthy_serials, num_healthy) if num_healthy > 0 else []
+
+        chosen_serials = chosen_failure + chosen_healthy
+        random.shuffle(chosen_serials)
+
+        print(f"Chosen failure serials: {chosen_failure}")
+        print(f"Chosen healthy serials: {chosen_healthy}")
+
+        df_subset = df[df["serial_number"].isin(chosen_serials)].copy()
+
+    print("Building inference samples ...")
+    print(
+        f"Using {len(FEATURE_COLS)} total model features: "
+        f"{len(present_feature_cols)} present, {len(missing_feature_cols)} zero-filled"
+    )
+    if USE_LOCAL_INFERENCE_CSV and ALLOW_SHORT_HISTORY:
+        print("ALLOW_SHORT_HISTORY=True: building one inference sample per row with left padding for early rows")
+    else:
+        print(f"ALLOW_SHORT_HISTORY={ALLOW_SHORT_HISTORY}: using standard sliding-window behavior")
+
+    samples = build_samples_from_subset(df_subset)
+    print(f"Built {len(samples)} inference samples")
+
+    if USE_LOCAL_INFERENCE_CSV:
+        print(f"Local csv rows: {len(df_subset)}")
+        print(f"Difference (rows - samples): {len(df_subset) - len(samples)}")
+
+    if len(samples) == 0:
+        raise ValueError(
+            f"No inference samples were built. Ensure each serial has at least {SEQ_LEN} rows "
+            f"or set ALLOW_SHORT_HISTORY=True."
+        )
+
+    print("Loading model from checkpoint ...")
+    model, args = load_model()
+
+    results = []
+    model_device = next(model.parameters()).device
+    print(f"Running batched inference with batch_size={BATCH_SIZE} on {model_device}")
+
+    if args.label_len > 0:
+        raise NotImplementedError("This inference script assumes label_len == 0")
+
+    with torch.no_grad():
+        processed = 0
+        for batch in batchify_samples(samples, BATCH_SIZE):
+            seq_x, seq_x_mark, seq_y_mark, metadata = collate_batch(batch)
+
+            seq_x = seq_x.to(model_device, non_blocking=True)
+            seq_x_mark = seq_x_mark.to(model_device, non_blocking=True)
+            seq_y_mark = seq_y_mark.to(model_device, non_blocking=True)
+
+            dec_inp = torch.zeros(
+                (seq_x.size(0), args.pred_len, 1),
+                dtype=torch.float32,
+                device=model_device,
+            )
+
+            outputs = model(seq_x, seq_x_mark, dec_inp, seq_y_mark)
+            logits = outputs.detach().float().cpu().view(-1).numpy()
+            probs = torch.sigmoid(outputs).detach().float().cpu().view(-1).numpy()
+
+            for meta, logit, prob in zip(metadata, logits, probs):
+                results.append(
+                    {
+                        "model_disk_model": MODEL_DISK_MODEL,
+                        "data_disk_model": DATA_DISK_MODEL,
+                        "serial_number": meta["serial_number"],
+                        "end_date": meta["end_date"],
+                        "y_true": meta["y_true"],
+                        "logit": float(logit),
+                        "prob": float(prob),
+                        "y_pred": int(prob >= 0.5),
+                    }
+                )
+
+            processed += len(batch)
+            if processed % 512 == 0 or processed == len(samples):
+                print(f"Inferenced {processed}/{len(samples)} samples")
+
+    df_out = pd.DataFrame(results)
+    df_out.to_csv(OUTPUT_CSV, index=False)
+
+    print(f"\nSaved inference results to: {OUTPUT_CSV}")
+    print(df_out.head())
+
+
+if __name__ == "__main__":
+    main()
\ No newline at end of file
