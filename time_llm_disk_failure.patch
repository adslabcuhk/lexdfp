@@ -0,0 +1,67 @@
+import pandas as pd
+import numpy as np
+
+# DISK_MODEL = "TOSHIBA MG08ACA16TEY"
+MODEL_DISK_MODEL = "HGST HUH721212ALN604"
+DATA_DISK_MODEL = "HGST HUH721212ALE604"
+CSV_PATH = f"./results/{MODEL_DISK_MODEL}__to__{DATA_DISK_MODEL}_inference.csv"
+
+df = pd.read_csv(CSV_PATH)
+
+# =========================
+# Basic counts
+# =========================
+y_true = df["y_true"].values
+y_pred = df["y_pred"].values
+
+TP = np.sum((y_true == 1) & (y_pred == 1))
+FP = np.sum((y_true == 0) & (y_pred == 1))
+TN = np.sum((y_true == 0) & (y_pred == 0))
+FN = np.sum((y_true == 1) & (y_pred == 0))
+
+print("Confusion Matrix:")
+print(f"TP={TP}, FP={FP}, TN={TN}, FN={FN}")
+
+# =========================
+# Metrics
+# =========================
+precision = TP / (TP + FP + 1e-12)
+recall = TP / (TP + FN + 1e-12)
+accuracy = (TP + TN) / (TP + TN + FP + FN + 1e-12)
+f1 = 2 * precision * recall / (precision + recall + 1e-12)
+
+print("\nPoint-wise Metrics:")
+print(f"Precision: {precision:.4f}")
+print(f"Recall:    {recall:.4f}")
+print(f"Accuracy:  {accuracy:.4f}")
+print(f"F1:        {f1:.4f}")
+
+# =========================
+# Event-level Recall
+# =========================
+# 定义：
+# 对每个 serial，如果：
+#   存在 y_true == 1
+# 且 存在至少一个 (y_true == 1 且 y_pred == 1)
+# → 记为一个 TP event
+
+event_tp = 0
+event_total = 0
+
+for serial, g in df.groupby("serial_number"):
+    has_failure = (g["y_true"] == 1).any()
+    
+    if has_failure:
+        event_total += 1
+        
+        detected = ((g["y_true"] == 1) & (g["y_pred"] == 1)).any()
+        
+        if detected:
+            event_tp += 1
+
+event_recall = event_tp / (event_total + 1e-12)
+
+print("\nEvent-level Metrics:")
+print(f"Event-level TP: {event_tp}")
+print(f"Total failure serials: {event_total}")
+print(f"Event-level Recall: {event_recall:.4f}")
