+import os
+import glob
+import pandas as pd
+from multiprocessing import Pool, cpu_count
+import warnings
+
+warnings.filterwarnings("ignore")
+
+# =========================================================
+# Configuration
+# =========================================================
+DISK_MODELS = [
+    "HGST HUH721212ALN604",
+    "ST12000NM0008",
+    "TOSHIBA MG08ACA16TA",
+    "TOSHIBA MG07ACA14TA"
+]
+
+BASE_DIR = ""   # TODO: base directory 
+INPUT_PATTERN = "matched_raw_*.csv"
+INPUT_SUBDIR = "matched"
+OUTPUT_SUBDIR = "matched/time_llm"
+
+TRAIN_MONTHS = {
+    "2024-01", "2024-02", "2024-03", "2024-04", "2024-05", "2024-06",
+    "2024-07", "2024-08", "2024-09", "2024-10", "2024-11", "2024-12",
+}
+VAL_MONTHS = {"2025-01", "2025-02", "2025-03"}
+TEST_MONTHS = {"2025-04", "2025-05", "2025-06", "2025-07", "2025-08", "2025-09"}
+
+
+# =========================================================
+# Helpers
+# =========================================================
+def extract_month_from_filename(path: str) -> str:
+    name = os.path.basename(path)
+    stem = os.path.splitext(name)[0]
+    return stem.split("_")[-1]
+
+
+def add_failure_7d(group: pd.DataFrame) -> pd.DataFrame:
+    """为单个 serial 添加 failure_7d"""
+    group = group.sort_values("date").copy()
+    group["failure_7d"] = (
+        group["failure"]
+        .iloc[::-1]
+        .rolling(window=7, min_periods=1)
+        .max()
+        .iloc[::-1]
+        .astype(int)
+    )
+    return group
+
+
+def load_and_merge(paths: list, split_name: str, disk_model: str) -> pd.DataFrame:
+    if not paths:
+        raise ValueError(f"No files for split={split_name}, model={disk_model}")
+
+    print(f"[{disk_model}] Loading {split_name}: {len(paths)} files...")
+
+    # 串行读取（外层已并行，此处不需要再开 Pool）
+    dfs = [pd.read_csv(p) for p in paths]
+    df = pd.concat(dfs, ignore_index=True)
+
+    df["date"] = pd.to_datetime(df["date"])
+    df["failure"] = df["failure"].fillna(0).astype(int)
+    df = df.sort_values(["serial_number", "date"]).reset_index(drop=True)
+
+    print(f"[{disk_model}] {split_name}: Concat done, total rows = {len(df):,}")
+
+    # 计算 failure_7d
+    print(f"[{disk_model}] Computing failure_7d for {split_name}...")
+
+    df = (
+        df.groupby("serial_number", group_keys=False)
+        .apply(add_failure_7d)
+        .reset_index(drop=True)
+    )
+
+    positives = int(df["failure_7d"].sum())
+    print(f"[{disk_model}] {split_name} finished → rows={len(df):,}, positives={positives}\n")
+
+    return df
+
+
+def build_split_for_model(disk_model: str):
+    model_root = os.path.join(BASE_DIR, disk_model)
+    input_dir = os.path.join(model_root, INPUT_SUBDIR)
+    output_dir = os.path.join(model_root, OUTPUT_SUBDIR)
+    os.makedirs(output_dir, exist_ok=True)
+
+    csv_files = sorted(glob.glob(os.path.join(input_dir, INPUT_PATTERN)))
+    if not csv_files:
+        print(f"Warning: No files found for {disk_model}")
+        return
+
+    print("=" * 90)
+    print(f"Processing disk model: {disk_model}  |  Total files: {len(csv_files)}")
+
+    train_files = [p for p in csv_files if extract_month_from_filename(p) in TRAIN_MONTHS]
+    val_files   = [p for p in csv_files if extract_month_from_filename(p) in VAL_MONTHS]
+    test_files  = [p for p in csv_files if extract_month_from_filename(p) in TEST_MONTHS]
+
+    train_df = load_and_merge(train_files, "train", disk_model)
+    val_df   = load_and_merge(val_files,   "val",   disk_model)
+    test_df  = load_and_merge(test_files,  "test",  disk_model)
+
+    # 保存结果
+    train_df.to_csv(os.path.join(output_dir, "train.csv"), index=False)
+    val_df.to_csv(  os.path.join(output_dir, "val.csv"),   index=False)
+    test_df.to_csv( os.path.join(output_dir, "test.csv"),  index=False)
+
+    print(f"✓ [{disk_model}] All files saved to: {output_dir}\n")
+
+
+def main():
+    print(f"CPU cores available: {cpu_count()}")
+    print("Starting parallel processing across disk models...\n")
+
+    # 只在外层并行（每个磁盘型号一个进程）
+    with Pool(processes=min(len(DISK_MODELS), cpu_count() // 2 + 1)) as pool:   # 保守使用 CPU 核数
+        pool.map(build_split_for_model, DISK_MODELS)
+
+    print("=== All disk models processed successfully! ===")
+
+
+if __name__ == "__main__":
