+import os
+import torch
+
+OLD_CKPT = "./ckpt/time_llm_fast_final.pth"
+NEW_CKPT = "./ckpt/time_llm_fast_final_adapter_only.pth"
+
+state = torch.load(OLD_CKPT, map_location="cpu")
+
+print(f"Loaded checkpoint from: {OLD_CKPT}")
+print(f"Total keys in old checkpoint: {len(state)}")
+
+adapter_state = {}
+llm_keys = []
+adapter_keys = []
+
+for k, v in state.items():
+    if k.startswith("llm_model."):
+        llm_keys.append(k)
+    else:
+        adapter_state[k] = v
+        adapter_keys.append(k)
+
