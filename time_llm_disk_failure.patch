+print("\nFirst 20 kept keys:")
+for k in adapter_keys[:20]:
+    print("  ", k)
+
+os.makedirs(os.path.dirname(NEW_CKPT), exist_ok=True)
+torch.save(adapter_state, NEW_CKPT)
+
+print(f"\nSaved adapter-only checkpoint to: {NEW_CKPT}")
