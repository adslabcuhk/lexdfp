index 0000000..44c6738
--- /dev/null
+++ b/data_provider/data_loader_backblaze.py
@@ -0,0 +1,415 @@
+import os
+import json
+import hashlib
+import pickle
+import numpy as np
+import pandas as pd
+from torch.utils.data import Dataset
+from sklearn.preprocessing import StandardScaler
+
+from utils.timefeatures import time_features
+
+import warnings
+warnings.filterwarnings('ignore')
+
+
+class Dataset_Backblaze(Dataset):
+    """
+    Backblaze dataset loader for Time-LLM-style interface.
+
+    Expected columns in input csv:
+      - date
+      - serial_number
+      - failure_7d
+      - SMART numeric columns such as smart_*_raw / smart_*_normalized
+
+    Returned items:
+      seq_x      : [seq_len, feature_dim]
+      seq_y      : [label_len + pred_len, 1]
+      seq_x_mark : [seq_len, time_feature_dim]
+      seq_y_mark : [label_len + pred_len, time_feature_dim]
+
+    Notes:
+      1. This loader is intentionally interface-compatible with the original
+         Time-LLM forecasting pipeline.
+      2. The classification label is packed into seq_y so the original
+         training loop can at least run through the data pipeline first.
+    """
+
+    def __init__(
+        self,
+        root_path,
+        flag='train',
+        size=None,
+        features='M',
+        data_path='' # TODO: path to the by month data
+        target='failure_7d',
+        scale=True,
+        timeenc=0,
+        freq='d',
+        percent=100,
+        seasonal_patterns=None
+    ):
+        if size is None:
+            self.seq_len = 30
+            self.label_len = 0
+            self.pred_len = 1
+        else:
+            self.seq_len = size[0]
+            self.label_len = size[1]
+            self.pred_len = size[2]
+
+        assert flag in ['train', 'val', 'test']
+        type_map = {'train': 0, 'val': 1, 'test': 2}
+        self.set_type = type_map[flag]
+
+        self.flag = flag
+        self.features = features
+        self.target = target
+        self.scale = scale
+        self.timeenc = timeenc
+        self.freq = freq
+        self.percent = percent
+
+        self.root_path = root_path
+        self.data_path = data_path
+
+        self.disk_model = os.path.basename(os.path.dirname(os.path.dirname(root_path.rstrip('/'))))
+        self.feature_json_path = ""  # TODO: path to the feature json file
+
+        self.scaler = StandardScaler()
+        self.samples = []
+        self.feature_cols = []
+
+        self.cache_version = 'v2'
+        self.max_windows_per_serial = 0
+        self.neg_to_pos_ratio = 2
+
+        self.max_windows_per_serial = int(os.environ.get('BACKBLAZE_MAX_WINDOWS_PER_SERIAL', '20'))
+        self.neg_to_pos_ratio = int(os.environ.get('BACKBLAZE_NEG_TO_POS_RATIO', '2'))
+        self.__read_data__()
+
+    def _build_cache_path(self, split_file):
+        cache_dir = os.path.join(self.root_path, '.cache_backblaze')
+        os.makedirs(cache_dir, exist_ok=True)
+
+        file_path = os.path.join(self.root_path, split_file)
+        file_mtime = int(os.path.getmtime(file_path))
+        train_file = os.path.join(self.root_path, 'train.csv')
+        train_mtime = int(os.path.getmtime(train_file)) if os.path.exists(train_file) else 0
+
+        feature_signature = getattr(self, 'feature_signature', 'none')
+
+        cache_key = {
+            'version': self.cache_version,
+            'flag': self.flag,
+            'seq_len': self.seq_len,
+            'label_len': self.label_len,
+            'pred_len': self.pred_len,
+            'target': self.target,
+            'percent': self.percent,
+            'scale': self.scale,
+            'timeenc': self.timeenc,
+            'freq': self.freq,
+            'split_file': split_file,
+            'split_mtime': file_mtime,
+            'train_mtime': train_mtime,
+            'max_windows_per_serial': self.max_windows_per_serial,
+            'neg_to_pos_ratio': self.neg_to_pos_ratio,
+            'feature_signature': feature_signature,
+        }
+
+        cache_name = hashlib.md5(str(cache_key).encode('utf-8')).hexdigest() + '.pkl'
+        return os.path.join(cache_dir, cache_name)
+
+    def _load_cache(self, cache_path):
+        with open(cache_path, 'rb') as f:
+            payload = pickle.load(f)
+        self.samples = payload['samples']
+        self.feature_cols = payload['feature_cols']
+        self.enc_in = payload['enc_in']
+
+    def _save_cache(self, cache_path):
+        payload = {
+            'samples': self.samples,
+            'feature_cols': self.feature_cols,
+            'enc_in': self.enc_in,
+        }
+        with open(cache_path, 'wb') as f:
+            pickle.dump(payload, f, protocol=pickle.HIGHEST_PROTOCOL)
+
+    def _load_selected_smart_cols(self):
+        with open(self.feature_json_path, "r") as f:
+            feature_map = json.load(f)
+
+        if self.disk_model not in feature_map:
+            raise ValueError(
+                f"Disk model {self.disk_model} not found in feature json: {self.feature_json_path}"
+            )
+
+        selected_smart_base = feature_map[self.disk_model]
+        return [f"{feat}_raw" for feat in selected_smart_base]
+
+    def _build_read_csv_kwargs(self, selected_smart_cols):
+        required_cols = ['date', 'serial_number', self.target, 'failure']
+        usecols = list(dict.fromkeys(required_cols + selected_smart_cols))
+
+        dtype_map = {
+            'serial_number': 'string',
+            self.target: np.float32,
+            'failure': np.float32,
+        }
+        for col in selected_smart_cols:
+            dtype_map[col] = np.float32
+
+        return {
+            'usecols': lambda c: c in usecols,
+            'dtype': dtype_map,
+            'low_memory': False,
+        }
+
+    def __read_data__(self):
+        if self.flag == 'train':
+            split_file = 'train.csv'
+        elif self.flag == 'val':
+            split_file = 'val.csv'
+        elif self.flag == 'test':
+            split_file = 'test.csv'
+        else:
+            raise ValueError(f"Unsupported flag: {self.flag}")
+
+        selected_smart_cols = self._load_selected_smart_cols()
+        self.feature_signature = ','.join(sorted(selected_smart_cols))
+
+        cache_path = self._build_cache_path(split_file)
+        if os.path.exists(cache_path):
+            self._load_cache(cache_path)
+            print(f"[Cache hit] Loaded cached split={self.flag} from {cache_path}")
+            return
+
+        file_path = os.path.join(self.root_path, split_file)
+        read_csv_kwargs = self._build_read_csv_kwargs(selected_smart_cols)
+        df_raw = pd.read_csv(file_path, **read_csv_kwargs)
+
+        required_cols = ['date', 'serial_number', self.target]
+        for col in required_cols:
+            if col not in df_raw.columns:
+                raise ValueError(f"Missing required column: {col}")
+
+        df_raw['date'] = pd.to_datetime(df_raw['date'])
+        df_raw = df_raw.sort_values(['serial_number', 'date']).reset_index(drop=True)
+
+        # -------- select feature columns --------
+        smart_cols = [
+            c for c in selected_smart_cols
+            if c in df_raw.columns and pd.api.types.is_numeric_dtype(df_raw[c])
+        ]
+
+        if len(smart_cols) == 0:
+            raise ValueError(
+                f"No usable feature columns found for disk model {self.disk_model}. "
+                f"Requested: {selected_smart_cols}"
+            )
+
+        feature_cols = smart_cols
+
+        # Drop target-like or non-feature columns if accidentally included
+        exclude_cols = {
+            'date', 'serial_number', 'failure', 'failure_7d',
+            'model', 'datacenter', 'cluster_id', 'vault_id',
+            'pod_id', 'pod_slot_num', 'is_legacy_format'
+        }
+        feature_cols = [c for c in feature_cols if c not in exclude_cols]
+
+        if len(feature_cols) == 0:
+            raise ValueError("No usable numeric SMART feature columns found.")
+
+        self.feature_cols = feature_cols
+        print(f"[{self.disk_model}] using {len(self.feature_cols)} features")
+
+        df_split = df_raw
+
+        # if self.set_type == 0 and self.percent < 100:
+        if self.percent < 100:
+            serials = df_split['serial_number'].drop_duplicates().tolist()
+            keep_n = max(1, int(len(serials) * self.percent / 100))
+
+            rng = np.random.default_rng(seed=42)
+            keep_serials = rng.choice(serials, size=keep_n, replace=False)
+
+            df_split = df_split[df_split['serial_number'].isin(keep_serials)].copy()
+
+        # -------- scaling --------
+        if self.scale:
+            train_file = os.path.join(self.root_path, 'train.csv')
+            train_read_csv_kwargs = self._build_read_csv_kwargs(selected_smart_cols)
+            train_df = pd.read_csv(train_file, **train_read_csv_kwargs)
+            train_values = train_df[self.feature_cols].astype(np.float32).fillna(0.0).values
+            self.scaler.fit(train_values)
+
+            split_values = df_split[self.feature_cols].astype(np.float32).fillna(0.0).values
+            df_split.loc[:, self.feature_cols] = self.scaler.transform(split_values)
+        else:
+            df_split.loc[:, self.feature_cols] = (
+                df_split[self.feature_cols].astype(np.float32).fillna(0.0)
+            )
+
+        # -------- build sliding-window samples (failure-centric sampling) --------
+        self.samples = []
+
+        for serial, g in df_split.groupby('serial_number'):
+            g = g.sort_values('date').reset_index(drop=True)
+
+            if len(g) < self.seq_len:
+                continue
+
+            feat_arr = g[self.feature_cols].values.astype(np.float32)
+            label_arr = g[self.target].fillna(0).astype(np.float32).values
+            failure_arr = g['failure'].fillna(0).astype(np.float32).values if 'failure' in g.columns else None
+            date_arr = pd.to_datetime(g['date']).values
+
+            # find true failure indices (anchor)
+            if failure_arr is not None:
+                failure_indices = np.where(failure_arr == 1)[0]
+            else:
+                failure_indices = np.array([])
+
+            window_count = 0
+
+            for s_begin in range(0, len(g) - self.seq_len + 1):
+                if self.max_windows_per_serial > 0 and window_count >= self.max_windows_per_serial:
+                    break
+
+                s_end = s_begin + self.seq_len
+                end_idx = s_end - 1
+
+                # ----------------------------
+                # failure-centric filtering
+                # ----------------------------
+                keep = False
+
+                if len(failure_indices) > 0:
+                    # distance to nearest failure
+                    dist = np.min(np.abs(failure_indices - end_idx))
+
+                    # keep near-failure windows (positive region)
+                    if dist <= 7:
+                        keep = True
+                    # keep some far-from-failure windows (negative region)
+                    elif 14 <= dist <= 30:
+                        # random downsample for negatives
+                        if np.random.rand() < 0.3:
+                            keep = True
+                else:
+                    # healthy disks → random subsample
+                    if np.random.rand() < 0.05:
+                        keep = True
+
+                if not keep:
+                    continue
+
+                seq_x = feat_arr[s_begin:s_end]
+                y = label_arr[end_idx]
+
+                x_dates = pd.to_datetime(date_arr[s_begin:s_end])
+                end_date = pd.to_datetime(x_dates[-1])
+
+                self.samples.append((seq_x, y, x_dates, serial, end_date))
+                window_count += 1
+
+        # -------- sample-level balancing for training --------
+        if self.flag == 'train':
+            pos_samples = [s for s in self.samples if s[1] == 1]
+            neg_samples = [s for s in self.samples if s[1] == 0]
+
+            print(f"[Before sampling] train positives: {len(pos_samples)}, negatives: {len(neg_samples)}")
+
+            # keep all positive samples
+            # randomly sample negatives with a controllable ratio
+            neg_to_pos_ratio = self.neg_to_pos_ratio
+
+            max_neg = min(len(neg_samples), len(pos_samples) * neg_to_pos_ratio)
+
+            rng = np.random.default_rng(seed=42)
+            if max_neg > 0:
+                chosen_neg_idx = rng.choice(len(neg_samples), size=max_neg, replace=False)
+                sampled_neg = [neg_samples[i] for i in chosen_neg_idx]
+            else:
+                sampled_neg = []
+
+            self.samples = pos_samples + sampled_neg
+            rng.shuffle(self.samples)
+
+            print(f"[After sampling] train positives: {len(pos_samples)}, sampled negatives: {len(sampled_neg)}, total: {len(self.samples)}")
+
+        if len(self.samples) == 0:
+            raise ValueError(f"No usable samples found for split={self.flag}")
+
+        self.enc_in = len(self.feature_cols)
+        self._save_cache(cache_path)
+        print(f"[Cache save] Saved cached split={self.flag} to {cache_path}")
+
+    def __getitem__(self, index):
+        # seq_x, y, x_dates = self.samples[index]
+        seq_x, y, x_dates, serial, end_date = self.samples[index]
+
+        # Keep seq_y compatible with original forecasting interface
+        seq_y_len = self.label_len + self.pred_len
+        if seq_y_len <= 0:
+            seq_y_len = 1
+
+        seq_y = np.full((seq_y_len, 1), y, dtype=np.float32)
+
+        # Build time marks in the same general style as the original loader
+        df_x_stamp = pd.DataFrame({'date': pd.to_datetime(x_dates)})
+
+        if self.timeenc == 0:
+            df_x_stamp['month'] = df_x_stamp.date.apply(lambda row: row.month)
+            df_x_stamp['day'] = df_x_stamp.date.apply(lambda row: row.day)
+            df_x_stamp['weekday'] = df_x_stamp.date.apply(lambda row: row.weekday())
+            df_x_stamp['hour'] = 0  # daily data
+            seq_x_mark = df_x_stamp.drop(['date'], axis=1).values.astype(np.float32)
+        elif self.timeenc == 1:
+            seq_x_mark = time_features(
+                pd.to_datetime(df_x_stamp['date'].values), freq=self.freq
+            ).transpose(1, 0).astype(np.float32)
+        else:
+            raise ValueError(f"Unsupported timeenc={self.timeenc}")
+
+        last_date = pd.to_datetime(x_dates[-1])
+        future_dates = pd.date_range(
+            start=last_date,
+            periods=seq_y_len,
+            freq='D'
+        )
+
+        df_y_stamp = pd.DataFrame({'date': future_dates})
+
+        if self.timeenc == 0:
+            df_y_stamp['month'] = df_y_stamp.date.apply(lambda row: row.month)
+            df_y_stamp['day'] = df_y_stamp.date.apply(lambda row: row.day)
+            df_y_stamp['weekday'] = df_y_stamp.date.apply(lambda row: row.weekday())
+            df_y_stamp['hour'] = 0
+            seq_y_mark = df_y_stamp.drop(['date'], axis=1).values.astype(np.float32)
+        elif self.timeenc == 1:
+            seq_y_mark = time_features(
+                pd.to_datetime(df_y_stamp['date'].values), freq=self.freq
+            ).transpose(1, 0).astype(np.float32)
+        else:
+            raise ValueError(f"Unsupported timeenc={self.timeenc}")
+
+        return seq_x, seq_y, seq_x_mark, seq_y_mark
+
+    def __len__(self):
+        return len(self.samples)
+
+    def inverse_transform(self, data):
+        return self.scaler.inverse_transform(data)
+
+    def get_sample_meta(self, index):
+        _, y, x_dates, serial, end_date = self.samples[index]
+        return {
+            "serial_number": serial,
+            "end_date": str(end_date.date()),
+            "y_true": int(y),
+        }
