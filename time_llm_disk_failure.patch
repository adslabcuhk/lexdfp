+import os
+import random
+import pickle
+import numpy as np
+import pandas as pd
+import torch
+import json
+
+from models import TimeLLM
+
+
+FEATURE_JSON_PATH = "" # TODO: path to the feature json file
+DISK_MODEL = "HGST HUH721212ALN604" 
+
+
+# =========================
+# Config
+# =========================
+CKPT_PATH = f"./ckpt/time_llm_{DISK_MODEL}.pth"
+TEST_CSV = "" # TODO: path to the csv of the DISK_MODEL
+LOCAL_INFERENCE_CSV = "" # TODO: path to the csv file of the DISK_MODEL test dataset
+USE_LOCAL_INFERENCE_CSV = LOCAL_INFERENCE_CSV is not None
+OUTPUT_CSV = f"./results/{DISK_MODEL}_inference.csv"
+
+RANDOM_SEED = 42
+NUM_SERIALS = 10
+SEQ_LEN = 14
+ALLOW_SHORT_HISTORY = True
+PRED_LEN = 1
+LABEL_LEN = 0
+BATCH_SIZE = 64
+
+TARGET_COL = "failure_7d"
+
+
+# =========================
+# Args for TimeLLM
+# =========================
+class Args:
+    def __init__(self):
+        self.task_name = "classification"
+
+        self.seq_len = SEQ_LEN
+        self.label_len = LABEL_LEN
+        self.pred_len = PRED_LEN
+
+        self.enc_in = None
+        self.dec_in = None
+        self.c_out = 1
+
+        self.d_model = 16
+        self.n_heads = 8
+        self.e_layers = 2
+        self.d_layers = 1
+        self.d_ff = 32
+        self.factor = 1
+        self.dropout = 0.1
